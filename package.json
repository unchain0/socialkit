{
  "name": "socialkit-docs",
  "version": "0.0.2",
  "description": "SocialKit documentation site built with Next.js and Nextra",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mdx --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.mdx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mdx,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,mdx,css,yml,yaml}\"",
    "check": "yarn format:check && yarn lint && yarn typecheck",
    "audit": "node scripts/audit.js",
    "audit:fix": "npm audit fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geiger01/socialkit-docs.git"
  },
  "author": "SocialKit Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/geiger01/socialkit-docs/issues"
  },
  "homepage": "https://github.com/geiger01/socialkit-docs#readme",
  "resolutions": {
    "lodash-es": "^4.18.0",
    "remark-reading-time": "^2.1.0",
    "postcss": "^8.5.23",
    "estree-util-value-to-estree": "^3.3.3",
    "@xmldom/xmldom": ">=0.9.12",
    "braces": ">=3.0.3"
  },
  "dependencies": {
    "autoprefixer": "^10.4.16",
    "next": "^14.2.0",
    "nextra": "^3.3.1",
    "nextra-theme-docs": "^3.3.1",
    "postcss": "^8.5.23",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.6"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.24",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-mdx": "^3.1.5",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0"
  },
  "packageManager": "yarn@1.22.22"
}
